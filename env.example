# Site Configuration
SITE_URL=https://fixmoney.in
NEXT_PUBLIC_SITE_URL=https://fixmoney.in

# Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your-google-analytics-id
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=your-gtm-id

# SEO
NEXT_PUBLIC_SITE_NAME=FixMoney.in
NEXT_PUBLIC_SITE_DESCRIPTION=Fix your money problems with AI-powered tools and smart strategies

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# API Keys (for future features)
# OPENAI_API_KEY=your-openai-api-key
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Database (for future features)
# DATABASE_URL=your-database-url
# DATABASE_AUTH_TOKEN=your-database-auth-token

# Email (for future features)
# SMTP_HOST=your-smtp-host
# SMTP_PORT=your-smtp-port
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password

# Payment (for future features)
# STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
# STRIPE_SECRET_KEY=your-stripe-secret-key

# Social Media
NEXT_PUBLIC_TWITTER_HANDLE=@fixmoney_in
NEXT_PUBLIC_FACEBOOK_PAGE=fixmoney.in
NEXT_PUBLIC_LINKEDIN_PAGE=company/fixmoney-in

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_ENABLE_PREMIUM_FEATURES=false
NEXT_PUBLIC_ENABLE_USER_ACCOUNTS=true 